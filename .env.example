# Bifrost gateway (OpenAI-compatible). Point this at your running Bifrost.
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=sk-nightfall-dev

# Model routing — three roles, each a model id your Bifrost serves (provider prefix included).
# Each role can name a DIFFERENT model on a DIFFERENT provider; swap freely without code changes.
# NOTE: today the loop's model calls all go through NF_MODEL_STRONG (the exploit_reason role:
# planner + Tavily-grounded hypothesis). Classification and report generation are deterministic
# and make no model call, so NF_MODEL_CHEAP / NF_MODEL_WRITE are wired but currently idle —
# NF_MODEL_STRONG is the lever that decides which model (and quota) a run actually spends.
NF_MODEL_CHEAP=gpt-4o-mini
NF_MODEL_STRONG=gpt-4o
NF_MODEL_WRITE=gpt-4o
# Ready-to-use provider options (uncomment one set; mix roles across providers to split load):
#   Gemini free tier:    gemini/gemini-3.5-flash-lite   (high RPD)   gemini/gemini-4-hydrogen (flagship)
#   Cloudflare Workers AI: cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8-fast   (~10k neurons/day)
#   Local Ollama:        ollama/qwen3.6:latest          (offline, no quota)
# Example — shed the reasoning load onto Cloudflare Llama while leaving the idle roles on Gemini:
#   NF_MODEL_CHEAP=gemini/gemini-3.5-flash-lite
#   NF_MODEL_STRONG=cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8-fast
#   NF_MODEL_WRITE=gemini/gemini-3.5-flash-lite

# Sampling — pinned for reproducible runs and cache hits
NF_TEMPERATURE=0
# NF_SEED=42

# Bifrost cache. We send x-bf-cache-key=sha256(model+prompt); type defaults to
# "direct" (exact hash match, no embedding model needed). Set NF_CACHE_ENABLED=false
# to stop sending the key. Requires the cache plugin + a store enabled in the Bifrost UI.
# NF_CACHE_ENABLED=true
# NF_CACHE_TYPE=direct        # or "semantic" (needs an embedding model configured)
# NF_CACHE_TTL=1h
# NF_CACHE_THRESHOLD=0.9

# Cost model. By default per-call cost is computed from token usage priced with
# Bifrost's own /v1/models catalog (provider-published, authoritative). These only
# override that: NF_PRICING wins per-model; the DEFAULT_IN/OUT are a last-resort
# estimate when a model is absent from the catalog (gateway.call then tags source=estimate).
# NF_PRICING={"gpt-4o":{"inPerMillion":2.5,"outPerMillion":10}}
# NF_PRICING_DEFAULT_IN=2.5
# NF_PRICING_DEFAULT_OUT=10

# Grounding freshness: advisories after this date are flagged freshAfterCutoff
NF_MODEL_CUTOFF=2024-06

# Tavily
TAVILY_API_KEY=tvly-REPLACE_ME
