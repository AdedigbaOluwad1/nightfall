# Bifrost gateway (OpenAI-compatible). Point this at your running Bifrost.
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=sk-nightfall-dev

# Model routing (must match what your Bifrost instance serves)
NF_MODEL_CHEAP=gpt-4o-mini
NF_MODEL_STRONG=gpt-4o
NF_MODEL_WRITE=gpt-4o

# Sampling — pinned for reproducible runs and cache hits
NF_TEMPERATURE=0
# NF_SEED=42

# Semantic cache (Bifrost). Set NF_CACHE_ENABLED=false to disable the cache key.
# NF_CACHE_ENABLED=true
# NF_CACHE_TTL=3600
# NF_CACHE_THRESHOLD=0.9

# Cost model (USD per 1M tokens). Optional overrides for Bifrost-served models.
# NF_PRICING={"gpt-4o":{"inPerMillion":2.5,"outPerMillion":10}}
# NF_PRICING_DEFAULT_IN=2.5
# NF_PRICING_DEFAULT_OUT=10

# Grounding freshness: advisories after this date are flagged freshAfterCutoff
NF_MODEL_CUTOFF=2024-06

# Tavily
TAVILY_API_KEY=tvly-REPLACE_ME
